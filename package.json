{
  "name": "fx-simulation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "node scripts/startLocal.mjs --no-open",
    "typecheck": "vue-tsc --noEmit",
    "test": "node scripts/runTests.mjs",
    "check:simulation": "node scripts/checkSimulation.mjs",
    "check:continuous": "node scripts/checkContinuousSimulation.mjs",
    "check:history": "node scripts/checkHistorySamples.mjs",
    "check:calibration": "node scripts/calibrateSimulation.mjs",
    "convert:histdata": "node scripts/convertHistData.mjs",
    "test:e2e": "playwright test",
    "test:e2e:release": "node scripts/runReleaseBrowserTests.mjs",
    "test:release": "node --test tests/unit/localServer.test.mjs tests/unit/packageWindows.test.mjs",
    "package:windows": "npm run build && node scripts/packageWindows.mjs",
    "check:release": "node scripts/packageWindows.mjs --verify",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "decimal.js": "10.6.0",
    "echarts": "6.1.0",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
